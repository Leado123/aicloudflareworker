		<title>SS Spanish</title>
	</head>
	<body class="w-full h-full">
        <div class="w-full h-full place-items-center justify-center flex">
            <div class="w-1/2 h-1/2 flex flex-col">
                <h1 class="text-4xl text-purple-500 text-center">Spanish Mode</h1>
                <div class="flex-1">
                    <SpanishComponent client:only />
                </div>
            </div>
