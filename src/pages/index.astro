---
import TopBar from "@/components/topbar";
import SideBar from "../components/sidebar";
import "../styles/global.css";
import Content from "@/components/content";
import { conversations } from "@/util/store";
import StoreManager from "@/components/StoreManager";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="https://i.redd.it/id-please-ik-its-a-meme-im-not-joking-v0-pveese881gna1.jpg?width=720&format=pjpg&auto=webp&s=e42849d3a376792cd8e86347615e9eb47396ec76" />

		<link rel="stylesheet" href="https://use.typekit.net/jbl5rvj.css">


		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>SS Studio</title>
	</head>
	<body class="w-full h-full">
		<StoreManager client:load>
			<div class="w-full h-full p-2 gap-2 flex">
				<SideBar client:visible />
				<div class="flex-1 flex gap-2 flex-col">
					<TopBar client:only />
					<Content client:only />
				</div>
			</div>
		</StoreManager>
	</body>
</html>
