datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model APIKeys {
    id        String   @id @default(cuid())
    key       String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    type      KeyType  @default(GEMINI)
}

enum KeyType {
    GEMINI
    CEREBRAS
}